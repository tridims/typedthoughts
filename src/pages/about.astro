---
import { Image } from "astro:assets";
import SocialImage from "@/assets/cat.jpeg";
import Content from "@/components/body/Content.astro";
import Footer from "@/components/footer/Footer.astro";
import BaseHead from "@/components/header/BaseHead.astro";
import Header from "@/components/header/Header.astro";
import Button from "@/components/ui/button.astro";
import ExternalLink from "@/components/utils/ExternalLink.astro";
import SocialLinks from "@/components/utils/SocialLinks.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description="About me description" title="About Me!" />
  </head>
  <body>
    <Header title="About me!" />
    <main class="container mx-auto pt-14" transition:animate="fade">
      <Content>
        <div
          class="bg-gradient-to-r from-primary/15 via-accent/50 to-secondary/50 backdrop-blur-2xl text-center py-4 px-6 rounded-2xl mb-16 mt-6 border border-primary/20 shadow-sm"
        >
          <div class="font-title font-bold text-foreground">
            Hello, I'm a Software Engineer from Indonesia!
          </div>
        </div>

        <section
          class="flex flex-col md:flex-row items-center justify-between gap-8 mb-14"
        >
          <div class="text-center md:text-left">
            <h1
              class="text-4xl font-bold mb-2 text-foreground font-title"
            >
              Dimas Tri Mustakim
            </h1>
            <p class="text-secondary-foreground">
              Software Developer / Digital Craftsman
            </p>
            <ExternalLink class="text-secondary-foreground"
              >me@dimastri.com</ExternalLink
            >
            <div class="mt-4 flex justify-center md:justify-start">
              <SocialLinks showLabels={true} />
            </div>
          </div>
          <div class="shrink-0">
            <Image
              alt="Profile Image"
              class="rounded-full w-40 h-40 object-cover shadow-lg ring-4 ring-primary/20"
              src={SocialImage}
            />
          </div>
        </section>

        <section class="mb-14 text-justify">
          <h2
            class="text-2xl font-bold mb-4 font-title flex items-center gap-3 before:h-6 before:w-1.5 before:rounded-full before:bg-primary before:content-['']"
          >
            Work
          </h2>
          <p class="indent-14 leading-relaxed">
            I am a passionate developer eager to learn and grow in the field. I
            thrive in both collaborative group environments and independent work
            settings. My ultimate career goal is to become an exceptional
            software engineer, dedicated to building cutting-edge technologies.
            I possess a knack for quickly adapting to new technologies through
            leveraging various available resources.
          </p>

          <p class="indent-14 leading-relaxed mb-8">
            I am well versed in backend development, devops, and cloud
            infrastructure. I am proficient in programming languages such as
            Python, Go and Javascript/Typescript. I also enjoy building things
            using different tech stack. Beyond technical skills, I actively seek
            opportunities to develop my management and interpersonal skills.
            Throughout my career and studies, I have gained valuable
            experience by working on various projects.
          </p>
          <div class="flex justify-center">
            <Button
              className="group font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5"
              size="lg"
              variant="default"
              href="mailto:me@dimastri.com"
            >
              Contact Me!
              <span class="transition-transform group-hover:translate-x-1"
                >&rarr;</span
              >
            </Button>
          </div>
        </section>

        <section class="mb-14">
          <h2
            class="text-2xl font-bold mb-4 font-title flex items-center gap-3 before:h-6 before:w-1.5 before:rounded-full before:bg-primary before:content-['']"
          >
            Bio
          </h2>
          <div class="flex flex-col gap-3">
            <div class="flex gap-4">
              <span class="font-semibold w-24 shrink-0 text-primary">2020-2024</span>
              <span
                >Education at&nbsp;
                <ExternalLink href="https://ub.ac.id"
                  >Brawijaya University</ExternalLink
                >, Computer Science Major.
              </span>
            </div>
            <div class="flex gap-4">
              <span class="font-semibold w-24 shrink-0 text-primary">2022-2024</span>
              <span>
                Practicum assistant & member of&nbsp;
                <ExternalLink href="https://icn-filkom.ub.ac.id"
                  >Information Centric Networking Lab</ExternalLink
                >
                &nbsp;at&nbsp;
                <ExternalLink href="https://filkom.ub.ac.id"
                  >FILKOM UB</ExternalLink
                >
              </span>
            </div>
            <div class="flex gap-4">
              <span class="font-semibold w-24 shrink-0 text-primary">2023-2024</span>
              <span>
                Student at Bangkit Academy by Google, GoTo, and Traveloka while
                Creating @SkinCheckAI
              </span>
            </div>
            <div class="flex gap-4">
              <span class="font-semibold w-24 shrink-0 text-primary">2024-Now</span>
              <span>
                Junior IT Developer at&nbsp;
                <ExternalLink href="https://cimbniaga.co.id"
                  >CIMB Niaga.</ExternalLink
                >
              </span>
            </div>
          </div>
        </section>

        <section class="mb-14 text-justify">
          <h2
            class="text-2xl font-bold mb-4 font-title flex items-center gap-3 before:h-6 before:w-1.5 before:rounded-full before:bg-primary before:content-['']"
          >
            I ❤️
          </h2>
          <p class="indent-14 leading-relaxed">
            My hobbies are quite diverse, and I particularly enjoy building
            things using a wide range of tech stacks. I love exploring various
            tech-related subjects, trying out different technologies, and
            creating small projects. In my free time, I find joy in
            experimenting with and utilizing different programming languages,
            deploying and exploring a variety of open-source applications that
            catch my attention, and building my own mini-lab on my computer.
            Additionally, I also like playing games, reading books, manga, and
            watching movies, anime, as well as youtube.
          </p>
        </section>
      </Content>
      <Footer />
    </main>
  </body>
</html>
