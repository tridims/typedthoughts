---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/blogs/Tag.astro";
import Footer from "@/components/footer/Footer.astro";
import BaseHead from "@/components/header/BaseHead.astro";
import Header from "@/components/header/Header.astro";
import ExternalLink from "@/components/utils/ExternalLink.astro";
import FormattedDate from "@/components/utils/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & {
  readingTime?: string;
  ogImage?: string;
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  externalPost,
  tags,
  readingTime,
  ogImage,
  headings = [],
} = Astro.props;

const tocItems = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3,
);
const hasToc = tocItems.length > 0;
const tocLinkClass =
  "block border-l-2 border-transparent py-0.5 text-muted-foreground transition-colors duration-200 hover:text-orange-500";
---

<html lang="en">
  <head>
    <BaseHead description={description} ogImage={ogImage} title={title} />
  </head>

  <body class="bg-background text-foreground">
    <Header />
    <main class="pt-20">
      <article class="max-w-3xl mx-auto px-6 py-12">
        <!-- Post Header: Contains metadata -->
        <header class="mb-8 text-center">
          {heroImage && (
                            <div class="mb-8">
                                <Image
                                    alt={"heroImage"}
                                    transition:animate="slide"
                                    class="h-auto w-full rounded-xl border border-border"
                                    height={510}
                                    transition:name={title}
                                    src={heroImage.image}
                                    width={1020}
                                />
                                {heroImage.source && (
                                    <p class="mt-2 text-muted-foreground text-xs">
                                        Image by{" "}
                                        <a class="hover:underline" href={heroImage.source} rel="noopener noreferrer" target="_blank">
                                            {heroImage.owner}
                                        </a>
                                    </p>
                                )}
                            </div>
                        )}

          <h1
            class="text-4xl md:text-5xl font-extrabold tracking-tight text-balance mb-4"
          >
            {title}
          </h1>

          <p class="text-lg text-muted-foreground mb-4">
            {description}
          </p>

          <div class="text-sm text-muted-foreground">
            <FormattedDate date={pubDate} />
            {readingTime && (
                                <>
                                    <span class="mx-2">&bull;</span>
                                    <span>{readingTime}</span>
                                </>
                            )}
            {updatedDate && (
                                <>
                                    <span class="mx-2">&bull;</span>
                                    <span>
                                        {"Updated on "}<FormattedDate
                                            date={updatedDate}
                                        />
                                    </span>
                                </>
                            )}
          </div>

          {externalPost && (
                            <p class="mt-2 text-muted-foreground text-sm">
                                Also available on{" "}
                                <ExternalLink href={externalPost}>
                                    another platform
                                </ExternalLink>.
                            </p>
                        )}

          {tags && tags.length > 0 && (
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              {tags.map((tag) => (
                <Tag tag={tag} />
              ))}
            </div>
          )}
        </header>

        <hr class="border-border my-8">

        <!-- Post Content: Styled with Tailwind Typography -->
        <div
          id="post-content"
          class="prose prose-lg dark:prose-invert max-w-none 
                        prose-headings:text-foreground 
                        prose-p:text-foreground
                        prose-a:text-orange-500 prose-a:no-underline hover:prose-a:underline
                        prose-strong:text-foreground
                        prose-blockquote:border-orange-500 prose-blockquote:text-muted-foreground
                        prose-li:marker:text-orange-500
                        prose-code:rounded-md prose-code:px-1.5 prose-code:py-1 prose-code:font-mono prose-code:text-sm
                        "
        >
          <slot />
        </div>
      </article>

      {hasToc && (
        <>
          {/* Table of contents: sticky on desktop */}
          <aside class="hidden xl:block fixed top-28 right-6 w-64 max-h-[70vh] overflow-y-auto overscroll-contain">
            <p class="mb-3 font-semibold text-foreground text-xs uppercase tracking-wider">
              On this page
            </p>
            <nav aria-label="Table of contents">
              <ul class="space-y-2 border-l border-border text-sm">
                {tocItems.map((heading) => (
                  <li>
                    <a
                      class={`${tocLinkClass} ${heading.depth === 3 ? "pl-6" : "pl-4"}`}
                      data-toc-link={heading.slug}
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>

          {/* Table of contents: collapsible on mobile */}
          <div class="xl:hidden">
            <button
              aria-controls="toc-mobile-panel"
              aria-expanded="false"
              aria-label="Toggle table of contents"
              class="fixed right-4 bottom-6 z-50 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-background text-foreground shadow-lg"
              data-toc-toggle
              type="button"
            >
              <svg
                aria-hidden="true"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round" />
              </svg>
            </button>

            <div
              class="fixed right-4 bottom-20 z-50 hidden max-h-[60vh] w-72 overflow-y-auto overscroll-contain rounded-xl border border-border bg-background p-4 shadow-xl"
              data-toc-panel
              id="toc-mobile-panel"
            >
              <p class="mb-3 font-semibold text-foreground text-xs uppercase tracking-wider">
                On this page
              </p>
              <nav aria-label="Table of contents">
                <ul class="space-y-2 border-l border-border text-sm">
                  {tocItems.map((heading) => (
                    <li>
                      <a
                        class={`${tocLinkClass} ${heading.depth === 3 ? "pl-6" : "pl-4"}`}
                        data-toc-link={heading.slug}
                        href={`#${heading.slug}`}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>
        </>
      )}
    </main>
    <Footer />

    <style is:global>
      #post-content :is(h2, h3) {
        scroll-margin-top: 5rem;
      }
    </style>

    <script>
      const SCROLL_OFFSET = 80;
      const SPY_OFFSET = 90;

      function setupToc() {
        const links = Array.from(
          document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
        );
        if (links.length === 0) return;
        if (links[0].dataset.tocBound === "true") return;
        links[0].dataset.tocBound = "true";

        const toggle =
          document.querySelector<HTMLButtonElement>("[data-toc-toggle]");
        const panel = document.querySelector<HTMLElement>("[data-toc-panel]");

        const ids = [...new Set(links.map((link) => link.dataset.tocLink ?? ""))];
        const headings = ids
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        if (headings.length === 0) return;

        let lockedId: string | null = null;
        let releaseTimer: number | undefined;
        let ticking = false;

        function markActive(id: string) {
          for (const link of links) {
            const active = link.dataset.tocLink === id;
            link.classList.toggle("text-orange-500", active);
            link.classList.toggle("border-orange-500", active);
            link.classList.toggle("border-transparent", !active);
            link.classList.toggle("text-muted-foreground", !active);
          }
        }

        function currentId() {
          const atBottom =
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 2;
          if (atBottom) return headings[headings.length - 1].id;

          let id = headings[0].id;
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top - SPY_OFFSET > 0) break;
            id = heading.id;
          }
          return id;
        }

        function scheduleRelease() {
          window.clearTimeout(releaseTimer);
          releaseTimer = window.setTimeout(() => {
            lockedId = null;
            (window as any).__headerScrollLock = false;
            markActive(currentId());
          }, 150);
        }

        function onScroll() {
          if (lockedId !== null) {
            scheduleRelease();
            return;
          }
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            markActive(currentId());
          });
        }

        function closePanel() {
          panel?.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
        }

        for (const link of links) {
          link.addEventListener("click", (event) => {
            const id = link.dataset.tocLink;
            const target = id ? document.getElementById(id) : null;
            if (!id || !target) return;

            // Scroll the window only, so the list itself does not move.
            event.preventDefault();
            lockedId = id;
            markActive(id);
            closePanel();

            // Keep the header hidden while the page jumps.
            const header = document.getElementById("site-header");
            header?.classList.add("-translate-y-full");
            (window as any).__headerScrollLock = true;

            const top =
              target.getBoundingClientRect().top +
              window.scrollY -
              SCROLL_OFFSET;
            window.scrollTo({ top, behavior: "smooth" });
            history.replaceState(null, "", `#${id}`);
            scheduleRelease();
          });
        }

        toggle?.addEventListener("click", () => {
          const open = panel?.classList.toggle("hidden") === false;
          toggle.setAttribute("aria-expanded", String(open));
        });

        document.addEventListener("click", (event) => {
          if (!panel || panel.classList.contains("hidden")) return;
          const target = event.target as HTMLElement;
          if (target.closest("[data-toc-panel], [data-toc-toggle]")) return;
          closePanel();
        });

        window.addEventListener("scroll", onScroll, { passive: true });
        markActive(currentId());
      }

      setupToc();
      document.addEventListener("astro:page-load", setupToc);
    </script>
  </body>
</html>
